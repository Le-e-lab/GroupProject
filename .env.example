# UPath environment template
# Copy this to .env and fill in real values locally.

PORT=3000
NODE_ENV=development

# Required: strong JWT secret (minimum 32 chars)
JWT_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI assistant settings
AI_ASSISTANT_ENABLED=true
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Optional bootstrap/debug flags
ENABLE_DEBUG_ROUTES=false
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_PASSWORD=replace-with-strong-password
